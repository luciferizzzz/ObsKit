{
  "name": "obskit",
  "version": "1.5.4",
  "description": "ObsKit (OBS = Organized Knowledge System) is a fast, lightweight, open-source CLI toolkit for managing Markdown knowledge bases directly from the terminal.",
  "main": "index.js",
  "bin": {
    "obsidian-helper": "bin/obs.js",
    "obsh": "./bin/obs.js",
    "obs": "./bin/obs.js"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "test:relationship": "node --test test/parser.test.js test/validator.test.js test/editor.test.js test/scanner.test.js test/formatter.test.js test/wikilinks.test.js",
    "lint": "echo \"No linting configured\"",
    "typecheck": "echo \"No type checking configured\""
  },
  "keywords": [
    "obskit",
    "obs",
    "obsidian",
    "obsidian-vault",
    "markdown",
    "knowledge-management",
    "notes",
    "cli",
    "terminal",
    "productivity"
  ],
  "author": "LevTikvah",
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luciferizzzz/obskit.git"
  },
  "homepage": "https://github.com/luciferizzzz/obskit#readme",
  "bugs": {
    "url": "https://github.com/luciferizzzz/obskit/issues"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "chalk": "^5.6.2",
    "commander": "^15.0.0"
  }
}
